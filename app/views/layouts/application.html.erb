<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Billetto Rails Test" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Billetto Rails Test">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="clerk-publishable-key" content="<%= ENV['CLERK_PUBLISHABLE_KEY'] %>">
    <meta name="turbo-cache-control" content="no-cache">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <script
      async
      crossorigin="anonymous"
      data-clerk-publishable-key="<%= ENV['CLERK_PUBLISHABLE_KEY'] %>"
      data-clerk-js-script-url="https://cdn.jsdelivr.net/npm/@clerk/clerk-js@latest/dist/clerk.browser.js"
      src="https://cdn.jsdelivr.net/npm/@clerk/clerk-js@latest/dist/clerk.browser.js">
    </script>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="main-nav" style="background: #ffffff; border-bottom: 1px solid #e2e8f0; padding: 16px 24px; margin-bottom: 24px;">
      <div style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 20px;">
          <strong style="font-size: 18px; color: #0f172a;">Billetto Events</strong>
          <% if clerk.user? %>
            <%= link_to "Events", events_path, style: "color: #475569; text-decoration: none; font-weight: 500;" %>
            <%= link_to "Profile", profile_path, style: "color: #475569; text-decoration: none; font-weight: 500;" %>
          <% end %>
        </div>

        <div style="display: flex; align-items: center; gap: 16px;">
          <% if clerk.user? %>
            <span style="font-size: 14px; color: #64748b;">
              <%= clerk.user&.email_addresses&.first&.email_address %>
            </span>
            <%= link_to "Sign Out", sign_out_path, id: "clerk-sign-out", data: { turbo: false }, class: "btn btn-secondary", style: "padding: 6px 12px; font-size: 14px;" %>
          <% else %>
            <% signInUrl = clerk.sign_in_url.presence || ENV['CLERK_SIGN_IN_URL'] %>
            <% signUpUrl = clerk.sign_up_url.presence || ENV['CLERK_SIGN_UP_URL'] %>

            <% if signInUrl.present? %>
              <%= link_to "Sign in", signInUrl, data: { turbo: false }, class: "btn btn-primary", style: "padding: 6px 14px; font-size: 14px;" %>
            <% end %>

            <% if signUpUrl.present? %>
              <%= link_to "Sign up", signUpUrl, data: { turbo: false }, class: "btn btn-secondary", style: "padding: 6px 14px; font-size: 14px;" %>
            <% end %>
          <% end %>
        </div>
      </div>
    </nav>

    <% if flash[:notice].present? %>
      <div class="alert alert-notice" style="max-width: 1200px; margin: 0 auto 16px; padding: 12px 16px; background-color: #d1fae5; color: #065f46; border-radius: 6px;">
        <%= flash[:notice] %>
      </div>
    <% end %>
    <% if flash[:alert].present? %>
      <div class="alert alert-danger" style="max-width: 1200px; margin: 0 auto 16px; padding: 12px 16px; background-color: #fee2e2; color: #991b1b; border-radius: 6px;">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
